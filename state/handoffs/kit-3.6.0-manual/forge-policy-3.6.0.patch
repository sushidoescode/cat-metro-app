+          # state/mode declares how much verification this repository runs under: the stakes mode
+          # and the server-side review floor. Both are checked here by CONTENT, not provenance —
+          # the provenance signal below is forgeable by a sufficiently privileged principal, and
+          # under the solo posture nothing else on the server requires a human. A diff that lowers
+          # either dimension therefore fails regardless of who signed it. Raising them is always
+          # allowed; the refusal is deliberately one-directional.
+          STATE_MODE = "state/mode"
+          MODE_RANK = {"sprint": 0, "standard": 1, "production": 2}
+          POSTURE_RANK = {"solo": 0, "dual": 1}
+
+          def read_blob(commit, path):
+              result = subprocess.run(
+                  ["git", "show", f"{commit}:{path}"],
+                  check=False,
+                  stdout=subprocess.PIPE,
+                  stderr=subprocess.PIPE,
+              )
+              if result.returncode:
+                  return None
+              return result.stdout.decode("utf-8", "replace")
+
+          def declared_rank(text, prefix, ranks, absent_default=None):
+              """Rank of one declaration. None = absent/ambiguous/unrecognized.
+
+              Parsing is strict and matches setup-rulesets.sh: exactly one whole line of the
+              form `<prefix><known value>`. Duplicates and unrecognized values read as unknown,
+              which the comparison below treats as a weakening — ambiguity is never a strengthening.
+              """
+              if text is None:
+                  return None
+              lines = [line for line in text.split("\n") if line.startswith(prefix)]
+              if not lines:
+                  return absent_default
+              if len(lines) != 1:
+                  return None
+              return ranks.get(lines[0][len(prefix):])

+          def state_mode_violations(base_text, head_text):
+              if base_text is None:
+                  # The declaration is being created (project init). Nothing to weaken from.
+                  return []
+              if head_text is None:
+                  return [
+                      "state/mode was deleted — the declaration cannot be removed; "
+                      "raising or lowering it is an explicit edit"
+                  ]
+              findings = []
+              for label, prefix, ranks, absent_default in (
+                  ("stakes mode", "mode=", MODE_RANK, None),
+                  # An absent posture line means dual — the documented default and the stricter
+                  # floor — so deleting the line can never be a weakening.
+                  ("review floor", "posture=", POSTURE_RANK, POSTURE_RANK["dual"]),
+              ):
+                  base_rank = declared_rank(base_text, prefix, ranks, absent_default)
+                  head_rank = declared_rank(head_text, prefix, ranks, absent_default)
+                  if base_rank is None:
+                      # Already ambiguous on the base: there is no defined level to fall from.
+                      continue
+                  if head_rank is None:
+                      findings.append(
+                          f"{label} became absent, duplicated, or unrecognized "
+                          f"(strict parse: exactly one `{prefix}<value>` line)"
+                      )
+                  elif head_rank < base_rank:
+                      findings.append(f"{label} was lowered")
+              return findings
+
