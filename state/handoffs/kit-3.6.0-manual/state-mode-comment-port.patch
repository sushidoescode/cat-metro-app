--- a/state/mode
+++ b/state/mode
@@ -2,5 +2,10 @@
 # What each mode changes is defined in evals/mode-policy.json (human-changeable only).
 # This file is under the enforcement belts too: changing it is a HUMAN-authored commit
 # (FORGE_HUMAN_OVERRIDE=1) — agents never dial down the ceremony they run under.
 mode=sprint
+# Server-side review-floor posture for scripts/setup-rulesets.sh: posture=dual | solo
+# dual (default) = forge-main: PR + 1 approval + code-owner review (needs a second human).
+# solo = forge-main-solo: 0 approvals, self-merge after green required checks — the
+# independent-review leg is process-level only. setup-rulesets refuses --solo without
+# this declaration; --check fails when installed posture != declared posture.
 posture=solo
