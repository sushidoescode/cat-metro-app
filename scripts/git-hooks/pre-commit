#!/usr/bin/env sh
# Forge universal enforcement — git-level, harness-agnostic.
# Works identically under Claude Code, Codex, Cursor, local-model CLIs, or bare human hands:
# blocks commits that touch immutable paths unless a human explicitly overrides.
# Installed via scripts/install-git-hooks.sh (git config core.hooksPath scripts/git-hooks).
#
# Human override (deliberate, logged in the commit itself):
#   FORGE_HUMAN_OVERRIDE=1 git commit -m "constitution: <why>"
#
# This is the enforcement floor when harness hooks don't exist. On Claude Code it is the
# THIRD belt (permissions + PreToolUse hooks fire earlier); everywhere else it may be the only one.
#
# Trust-chain note: evals/results/ splits into agent-writable claims (anything not under
# attested/) and evals/results/attested/ — human/CI-authored evidence that alone can RAISE the
# autonomy dial (scripts/forge-trust.sh). state/mode (the stakes posture) is likewise a
# human-authored change: agents never dial down the ceremony they run under.

[ "$FORGE_HUMAN_OVERRIDE" = "1" ] && exit 0

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

blocked=""
for f in $staged; do
  case "$f" in
    evals/results/attested/*)
      blocked="$blocked\n  $f (attested evidence: human/CI only)" ;;
    evals/results/*) ;;  # the writable carve-out — agents record claims/benchmark/audit results here
    tests/contract/*|docs/constitution.md|.claude/hooks/*|scripts/git-hooks/*|evals/*|state/mode|state/trust.json|.github/workflows/*|CODEOWNERS|.github/CODEOWNERS|docs/CODEOWNERS)
      blocked="$blocked\n  $f" ;;
  esac
done

if [ -n "$blocked" ]; then
  printf 'forge pre-commit: BLOCKED — commit touches immutable paths:%b\n' "$blocked"
  printf 'These require a human-authored change. If you are the human and this is deliberate:\n'
  printf '  FORGE_HUMAN_OVERRIDE=1 git commit ...\n'
  exit 1
fi
exit 0
