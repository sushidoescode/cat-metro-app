.DS_Store
.env
.env.*
.claude/settings.local.json
CLAUDE.local.md
state/gate-views/
state/run-records/
state/gate-ledger/
# TODO(stack): append engine-specific ignores when the stack lands
# (Unity: Library/ Temp/ Logs/ UserSettings/ · Gradle/Android: .gradle/ build/ local.properties · Godot: .godot/)

# dotnet build outputs (ADR-0005 dotnet leg; TODO(stack) engine entries land with the scaffold)
dotnet/**/bin/
dotnet/**/obj/

# Unity scaffold (Q-G): generated/local state never enters the repo
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/.vsconfig
unity/.vscode/

# RICH-ASSETS: generated candidates are LOCAL until curated + provenance'd
# (Polyfork custody pattern; promotion path in docs/design/assets/PIPELINE.md)
unity/Assets/Art/Generated/incoming/
# F11: if Unity opens the project after a generation run it writes .meta files for the
# generated tree's parent folders, which the line above does not cover — ignore them too
# so an unrelated `git add -A` cannot sweep them in.
unity/Assets/Art/Generated.meta
unity/Assets/Art/Generated/incoming.meta

# Upload keys and passwords are never repository or agent material. If one lands here, treat it as
# compromised and use Play's upload-key reset; rewriting Git history alone is not sufficient.
*.keystore
*.jks
*.p12
*.pem
*.pfx
*.bks
*.key
# STORE-RELEASE: the extension list above misses the file that carries the keystore
# PASSWORD rather than the key itself. Gradle's conventional name is keystore.properties,
# and Unity writes local.properties next to it.
keystore.properties
local.properties

# STORE-RELEASE: build outputs. scripts/build-apk.sh and scripts/build-aab.sh write here,
# and a release .aab is 100MB+ — nothing in this tree was ignored before, so a stray
# `git add -A` could have committed one. (The line-10 TODO promised `build/` and never
# delivered it.)
build/
*.aab
*.apk

# Build artifacts. scripts/build-apk.sh, build-ios.sh and the AAB builder all write here.
# This was previously unignored, which was survivable while the only output was one APK and
# is not once iOS lands: Unity emits an Xcode PROJECT — thousands of files, including a
# full copy of the built Data payload and therefore of the licensed Meshy/Tripo/Polyfork
# meshes. A single `git add -A` would commit the paid art as a build artifact.
build/
*.ipa
*.xcarchive/
*.dSYM/

# Apple signing material — same Never-in-repo / Never-agent-reachable posture as the Android
# upload keystore above (docs/security/threat-model.md). *.p12 / *.pem / *.key are already
# covered by the keystore block; these are the Apple-specific formats it does not catch.
#   *.p8              App Store Connect API key (AuthKey_XXXXXXXXXX.p8) — signs uploads and
#                     authenticates the ASC API. Apple lets you download it exactly ONCE and
#                     will not reissue it. Leaking it is an account-level compromise; the
#                     only remedy is revoking the key in App Store Connect > Users and
#                     Access > Integrations.
#   *.mobileprovision Provisioning profiles: embed the team ID, app ID and device UDIDs.
#   *.cer             Distribution/development certificates as downloaded from Apple.
*.p8
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest

# Xcode local state and the export descriptor (carries your team ID; machine-specific)
xcuserdata/
*.xcuserstate
ExportOptions.plist

# Unity MCP: generated client config carries a live bearer token — never commit it
# (the Editor's UserSettings/mcp.json is already covered by unity/UserSettings/ above)
.mcp.json
unity/.mcp.json

# RevenueCat API key. The real config is never committed; the .example sibling documents
# its shape. Absent config means the game runs with purchases unavailable, which is a
# working game — see unity/Assets/Scripts/Integrations/MonetizationConfig.cs.
unity/Assets/Resources/Monetization/revenuecat_config.json
unity/Assets/Resources/Monetization/revenuecat_config.json.meta

# Rewarded ads app/ad-unit identifiers are local runtime config. The committed root example is
# deliberately blank; exact runtime Resources and Unity's generated meta stay local.
unity/Assets/Resources/Monetization/rewarded_ads_config.json
unity/Assets/Resources/Monetization/rewarded_ads_config.json.meta

# Local Unity and .NET test reports.
artifacts/
