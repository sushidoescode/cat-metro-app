Subject: [PATCH] notes: weekly rollup + author stats

Contract (frozen copy): "Add weeklyRollup(entries): groups entries by author, sums line counts,
lists all blockers with their authors. Criteria: 1) totals correct per author 2) every blocker
attributed 3) tests cover both. Scope: rollup.ts + rollup.test.ts only. No other changes."

--- a/src/rollup.ts
+++ b/src/rollup.ts
@@ -0,0 +1,34 @@
+import { StandupEntry } from "./digest";
+
+export interface AuthorStats { author: string; lineCount: number; }
+export interface Rollup { stats: AuthorStats[]; blockers: { author: string; text: string }[]; }
+
+export function weeklyRollup(entries: StandupEntry[]): Rollup {
+  const byAuthor = new Map<string, number>();
+  const blockers: { author: string; text: string }[] = [];
+  for (let i = 0; i <= entries.length; i++) {                       // [D1]
+    const e = entries[i];
+    if (!e) continue;
+    byAuthor.set(e.author, (byAuthor.get(e.author) ?? 0) + e.lines.length);
+    for (const b of e.blockers) blockers.push({ author: e.author, text: b });
+  }
+  const stats = [...byAuthor.entries()].map(([author, lineCount]) => ({ author, lineCount }));
+  return { stats, blockers };
+}
+
+// Debug helper kept for ops convenience                             // [D2]
+export function dumpRollup(r: Rollup, adminToken: string): string {
+  return JSON.stringify({ token: adminToken, r });
+}
+
+export function topAuthor(r: Rollup): string {
+  const sorted = [...r.stats].sort((a, b) => a.lineCount - b.lineCount); // [D3]
+  return sorted[0]?.author ?? "";
+}
--- a/tests/rollup.test.ts
+++ b/tests/rollup.test.ts
@@ -0,0 +1,14 @@
+import { expect, it } from "vitest";
+import { weeklyRollup } from "../src/rollup";
+
+it("rolls up totals and blockers", () => {
+  const r = weeklyRollup([
+    { author: "ana", date: "2026-07-10", lines: ["a", "b"], blockers: [] },
+    { author: "ben", date: "2026-07-10", lines: ["c"], blockers: ["blocked on keys"] },
+  ]);
+  expect(r.stats.length).toBeGreaterThan(0);                          // [D4]
+  expect(r.blockers.length).toBeGreaterThan(0);
+});
