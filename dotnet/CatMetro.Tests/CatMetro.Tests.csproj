<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0005 test-split parity (:169-172): links Assets/Tests/EditMode/Pure/** and ONLY that.
       NUnit 3.x (not 4) because Unity Test Framework is NUnit-3-based: the same [Test] sources
       must compile under both hosts. Microsoft.NET.Test.Sdk is the dotnet-test platform
       precondition (handoff A-C1-9). Exact pins only; lock file committed (ADR-0004:90-96). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Tests/EditMode/Pure/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CatMetro.Domain/CatMetro.Domain.csproj" />
    <ProjectReference Include="../CatMetro.Content/CatMetro.Content.csproj" />
    <ProjectReference Include="../CatMetro.Services/CatMetro.Services.csproj" />
    <ProjectReference Include="../CatMetro.Application/CatMetro.Application.csproj" />
  </ItemGroup>

</Project>
